# Copy to .env.local and adjust. Everything else (your account, currency,
# MCP access) is set up in the app on first launch and stored in the database.

# Where the data lives: a local SQLite file (default)…
DATABASE_URL=file:./data/dashboard.db
# …or a Turso / libSQL database for serverless hosts:
# DATABASE_URL=libsql://<your-db>.turso.io
# DATABASE_AUTH_TOKEN=
